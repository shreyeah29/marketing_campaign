// ═══════════════════════════════════════════════════════════════════════════════
// VSP AI Marketing OS — data model
//
// Conventions, applied without exception:
//   · UUIDv7 primary keys — time-ordered, so index locality stays good at scale.
//   · createdAt / updatedAt on every table; deletedAt where soft delete applies.
//   · Every tenant-scoped table carries organizationId, and every index on such a
//     table leads with organizationId so tenant-filtered queries stay sargable.
//   · snake_case in the database, camelCase in TypeScript, mapped explicitly.
//   · Money is Decimal, never Float. Token counts are Int.
//   · Enums are database enums, so an invalid state cannot be persisted.
//
// Tenant isolation is enforced at three layers (see docs/ARCHITECTURE.md §5):
//   1. AsyncLocalStorage request context
//   2. Prisma client extension injecting organizationId — fails closed
//   3. Postgres row-level security — see migrations/*_row_level_security
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector, pg_trgm, citext]
}

