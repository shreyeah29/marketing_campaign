{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.md",
      "options": { "printWidth": 90, "proseWrap": "preserve" }
    },
    {
      "files": "*.prisma",
      "options": { "printWidth": 120 }
    }
  ]
}
