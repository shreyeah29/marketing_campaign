# ─────────────────────────────────────────────────────────────────────────────
# VSP AI Marketing OS — environment template
#
# Copy to .env for local development. Never commit .env.
# Production values live in the host's secret store (Vercel / Railway), not here.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ─── Core infrastructure ─────────────────────────────────────────────────────
# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/vsp_marketing?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/vsp_marketing?sslmode=require"

# Upstash Redis — cache, BullMQ, rate limiting.
REDIS_URL="rediss://default:password@host:6379"

# ─── Application URLs ────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"

# ─── Encryption ──────────────────────────────────────────────────────────────
# Master key wrapping per-organisation provider credentials.
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# ─── AI providers (all optional — the model router uses what is configured) ──
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""

# ─── Media generation ────────────────────────────────────────────────────────
IDEOGRAM_API_KEY=""
STABILITY_API_KEY=""
FAL_API_KEY=""
RUNWAY_API_KEY=""
LUMA_API_KEY=""

# ─── Voice and telephony ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Messaging ───────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="VSP AI Marketing OS <noreply@example.com>"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ─── Social platforms ────────────────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vsp-marketing-media"
R2_PUBLIC_URL=""

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
POSTHOG_API_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
