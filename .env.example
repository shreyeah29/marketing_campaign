# ─────────────────────────────────────────────────────────────────────────────
# VSP AI Marketing OS — environment template
#
# Copy to .env for local development. Never commit .env.
# Production values live in the host's secret store (Vercel / Railway), not here.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ─── Core infrastructure ─────────────────────────────────────────────────────
# TWO DIFFERENT ROLES. This is a security boundary, not a performance detail.
#
#   DATABASE_URL        → the application role (vsp_app). Not a superuser, does
#                         not own the tables, has no BYPASSRLS. Row-level
#                         security is therefore absolute for this connection,
#                         and tenant isolation cannot be circumvented by
#                         application code — including by SQL injection that
#                         reaches raw query execution.
#
#   DIRECT_DATABASE_URL → the owner role. Used ONLY by migrations and seeds,
#                         which need to write across tenants. The owner is
#                         exempt from RLS, so the running application must never
#                         use it.
#
# Provision the application role once per environment, after migrations:
#   psql "$DIRECT_DATABASE_URL" \
#     -v app_password="$(openssl rand -base64 32)" \
#     -f packages/database/scripts/provision-app-role.sql
#
# The API asserts at boot that DATABASE_URL is genuinely subject to RLS and
# refuses to start otherwise. Requires PostgreSQL 17 with the pgvector extension.
DATABASE_URL="postgresql://vsp_app:password@host/vsp_marketing?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://owner:password@host/vsp_marketing?sslmode=require"

# Upstash Redis — cache, BullMQ, rate limiting.
REDIS_URL="rediss://default:password@host:6379"

# ─── Application URLs ────────────────────────────────────────────────────────
API_PORT=4000

# The frontend's public origin. Used to build the links in verification / reset /
# invitation emails, and it is where a user is sent after clicking one.
#   Local dev  : http://localhost:3000
#   Production : https://marketing-campaign-six.vercel.app   (your Vercel frontend)
APP_URL="http://localhost:3000"

# Comma-separated allowlist of origins permitted by CORS *and* accepted as CSRF
# trusted origins by Better Auth. MUST include the frontend origin.
#   Local dev  : http://localhost:3000
#   Production : https://marketing-campaign-six.vercel.app
# (Add any Vercel *preview* URLs you want to test against too, comma-separated.)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# The API's own public base URL (where /api/auth/* is served from). In production
# this is your deployed backend's URL, e.g. https://your-backend.onrender.com
BETTER_AUTH_URL="http://localhost:4000"

# NOTE (frontend/Vercel): the frontend reads NEXT_PUBLIC_API_URL and must point at
# the PUBLIC backend URL. It lives in apps/web/.env.example and is set in the Vercel
# dashboard — not here. See apps/web/.env.example.

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"

# ─── Encryption ──────────────────────────────────────────────────────────────
# Master key wrapping per-organisation provider credentials.
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# ─── AI providers (all optional — the model router uses what is configured) ──
# Which image model draws designed posters. One name, or a comma-separated list
# tried in order. Leave unset for the built-in order (gpt-image-2, gpt-image-1,
# dall-e-3). Set it when the account can only use one of them — availability
# depends on organisation verification and tier.
OPENAI_IMAGE_MODEL=

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""

# ─── Media generation ────────────────────────────────────────────────────────
IDEOGRAM_API_KEY=""
STABILITY_API_KEY=""
FAL_API_KEY=""
RUNWAY_API_KEY=""
LUMA_API_KEY=""

# ─── Creative storage (Supabase Storage) ─────────────────────────────────────
# Runway returns URLs that expire, so every generated poster and video is copied
# into a bucket we own and the durable link is what gets stored. Leave unset and
# generation still works — but the media it produces dies within days.
# Set on BOTH the API and the worker — the API stores uploads and generated
# scenes, the worker writes every rendered poster. The service key bypasses
# row-level security: server environments only, never the browser, never a
# commit.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="creatives"

# ─── Voice and telephony ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Messaging ───────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="VSP AI Marketing OS <noreply@example.com>"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ─── Meta ads + WhatsApp lead engine ─────────────────────────────────────────
# The platform's single operator-owned Meta App. A client's per-tenant token is a
# delegated OAuth grant stored encrypted per organisation — never here. Fill these
# in after Meta enrolment (Business Verification + App Review); until then the Meta
# features stay dormant and the app boots normally.
META_APP_ID=""
META_APP_SECRET=""
# Graph API version (defaults to v21.0 if unset).
META_GRAPH_VERSION="v21.0"
# Where Meta redirects a client back to after they authorise the connection, e.g.
# https://your-backend.onrender.com/v1/meta/oauth/callback
META_OAUTH_REDIRECT_URI=""
# Optional Facebook Login / WhatsApp Embedded-Signup configuration id.
META_CONFIG_ID=""
# Any random string you also set in the Meta webhook config; echoed back on the
# subscription handshake for both leadgen and WhatsApp inbound webhooks.
META_WEBHOOK_VERIFY_TOKEN=""

# ─── Social platforms ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ─── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="marketing-os-media"
R2_PUBLIC_URL=""

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
POSTHOG_API_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
